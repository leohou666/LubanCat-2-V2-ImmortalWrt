#!/bin/sh

. /lib/functions.sh

[ "$(board_name)" = "embedfire,lubancat-2" ] || exit 0
[ -x /etc/init.d/sqm ] || exit 0
[ -f /usr/lib/sqm/simplest_tbf.qos ] || exit 0

# 仅替换软件包自带的出厂配置，保留升级时用户已有的 SQM 设置。
queues="$(uci -q show sqm | sed -n 's/^sqm\.\([^.=]*\)=queue$/\1/p')"
[ "$queues" = "eth1" ] || exit 0
[ "$(uci -q get sqm.eth1.enabled)" = 0 ] || exit 0
[ "$(uci -q get sqm.eth1.interface)" = eth1 ] || exit 0
[ "$(uci -q get sqm.eth1.download)" = 85000 ] || exit 0
[ "$(uci -q get sqm.eth1.upload)" = 10000 ] || exit 0
[ "$(uci -q get sqm.eth1.qdisc)" = cake ] || exit 0
[ "$(uci -q get sqm.eth1.script)" = piece_of_cake.qos ] || exit 0

uci -q batch <<'EOF'
delete sqm.eth1
set sqm.lubancat_wan=queue
set sqm.lubancat_wan.enabled='1'
set sqm.lubancat_wan.interface='eth0'
set sqm.lubancat_wan.download='750000'
set sqm.lubancat_wan.upload='0'
set sqm.lubancat_wan.qdisc='fq_codel'
set sqm.lubancat_wan.script='simplest_tbf.qos'
set sqm.lubancat_wan.linklayer='ethernet'
set sqm.lubancat_wan.overhead='44'
set sqm.lubancat_wan.use_mq='0'
set sqm.lubancat_wan.debug_logging='0'
set sqm.lubancat_wan.verbosity='5'
set firewall.@defaults[0].flow_offloading='0'
set firewall.@defaults[0].flow_offloading_hw='0'
EOF
[ "$?" -eq 0 ] || exit 1
uci commit sqm || exit 1
uci commit firewall || exit 1
/etc/init.d/sqm enable
